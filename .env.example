# ==============================================================================
# Zonos Customs - eBay API & Environment Configuration Template (.env.example)
# ==============================================================================
# Instructions:
# 1. Copy this file to .env.local in the project root directory:
#    cp .env.example .env.local
# 2. Fill in your actual backend/proxy URL and browser-safe public IDs only.
# 3. NEVER put Client Secret, Access Token, Refresh Token, passwords, or other secrets here.
# 4. NEVER commit .env.local to git repository.
# ==============================================================================

# API Execution Mode: 'live_api' (Production Real eBay API) or 'mock' (Development Test Only)
VITE_EBAY_API_MODE=live_api

# Secure backend origin used by the Inventory Sales Workbench Sandbox connection UI.
# Example: http://localhost:3001 or https://api.yourdomain.com
VITE_BACKEND_BASE_URL=http://localhost:3001

# Existing eBay backend/proxy API base URL used by other modules.
# Example: http://localhost:3001/api/ebay or https://api.yourdomain.com/api/ebay
VITE_EBAY_API_BASE_URL=http://localhost:3001/api/ebay

# Browser-safe eBay Application App ID / Client ID only. Never place Client Secret here.
VITE_EBAY_CLIENT_ID=YOUR_EBAY_CLIENT_ID_HERE

# Google OAuth 2.0 Client ID for Google Drive Integration (Browser Public Key)
# Scope: https://www.googleapis.com/auth/drive.file
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE
