# Server Port Configuration
PORT=3001

# Application Environment (development / production)
NODE_ENV=development

# 32-byte (256-bit) Hexadecimal Key for AES-256-GCM Token Encryption
# You can generate a secure key with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# eBay Production Client Secret (Keep blank for security)
EBAY_CLIENT_SECRET=

# eBay Sandbox network execution is fail-closed by default.
# Keep false until an approved Sandbox OAuth/getVersion test is ready.
EBAY_SANDBOX_NETWORK_ENABLED=false

# Separate write gate for cross-channel inventory synchronization in eBay Sandbox.
# Both this and EBAY_SANDBOX_NETWORK_ENABLED must be true before quantity-changing requests can be sent.
# Keep false during normal development/CI.
EBAY_SANDBOX_INVENTORY_SYNC_WRITE_ENABLED=false

# Example backend-only Sandbox credential reference.
# The browser/app stores only the reference name: EBAY_SANDBOX_MAIN
# Never commit real values. Put them only in the local/server secret environment.
EBAY_SANDBOX_MAIN_CLIENT_ID=
EBAY_SANDBOX_MAIN_CLIENT_SECRET=
EBAY_SANDBOX_MAIN_RUNAME=
