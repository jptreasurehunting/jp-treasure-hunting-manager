# Server Port Configuration
PORT=3001

# Application Environment (development / production)
NODE_ENV=development

# 32-byte (256-bit) Hexadecimal Key for AES-256-GCM Token Encryption
# You can generate a secure key with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# eBay Production Client Secret (Keep blank for security)
EBAY_CLIENT_SECRET=
